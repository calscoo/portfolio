body{font-family:open sans,sans-serif;color:#e9e3d6;background-color:#121110;margin:0;display:flex;flex-direction:column;min-height:100vh}a{color:#e8a33d}a:hover{color:#f5c065}pre code{font-family:fira mono,monospace;font-size:75%;display:block;background:#1a1815;padding:10px;overflow:auto}code{font-family:fira mono,monospace;font-size:75%}h1{font-family:fira mono,monospace}h2{font-family:fira mono,monospace}h3{font-family:fira mono,monospace}h4{font-family:fira mono,monospace}h5{font-family:fira mono,monospace}h6{font-family:fira mono,monospace}@-ms-viewport{width: device-width; }@font-face{font-family:fira mono;src:url(../fonts/FiraMono/FiraMono-Medium.eot);src:local("Fira Mono"),url(../fonts/FiraMono/FiraMono-Medium.eot)format("embedded-opentype"),url(../fonts/FiraMono/FiraMono-Medium.woff)format("woff"),url(../fonts/FiraMono/FiraMono-Medium.ttf)format("truetype");font-weight:500;font-style:normal}@font-face{font-family:open sans;src:url(../fonts/OpenSans/OpenSans-Regular.eot);src:url(../fonts/OpenSans/OpenSans-Regular.eot?#iefix)format("embedded-opentype"),url(../fonts/OpenSans/OpenSans-Regular.woff)format("woff"),url(../fonts/OpenSans/OpenSans-Regular.ttf)format("truetype"),url(../fonts/OpenSans/OpenSans-Regular.svg#OpenSansRegular)format("svg");font-weight:400;font-style:normal}.footer{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:13px 20px;font-family:fira mono,monospace;font-size:.8em;color:#8a8272;background-color:#1a1815;border-top:1px solid #2a261f}.footerAccent{color:#e8a33d}.footerLink{color:#e9e3d6}@media screen and (max-width:768px){.footer{flex-direction:column;gap:4px;text-align:center}}.header{font-family:fira mono,monospace;padding:0 20px;height:60px;display:flex;justify-content:space-between;align-items:center;width:760px}.headerWrapper{overflow:auto;box-sizing:border-box;background-color:#1a1815;display:flex;justify-content:center;flex-shrink:0}.headerLinks ul{list-style:none;padding:0;margin:0}.headerLinks ul li{display:inline;margin:5px}.headerLinks ul li a{color:#8a8272;text-decoration:none}.headerLinks ul li a:hover{color:#f5c065}.terminal{color:#e9e3d6;text-decoration:none}.hamb{cursor:pointer;float:right;display:none}.hamb-line{background:#e9e3d6;display:block;height:2px;position:relative;width:24px}.hamb-line::before,.hamb-line::after{background:#e9e3d6;content:"";display:block;height:100%;position:absolute;transition:all .2s ease-out;width:100%}.hamb-line::before{top:5px}.hamb-line::after{top:-5px}.side-menu{display:none}.side-menu:checked~.headerLinks{max-height:100%}.side-menu:checked~.hamb .hamb-line{background:0 0}.side-menu:checked~.hamb .hamb-line::before{transform:rotate(-45deg);top:0}.side-menu:checked~.hamb .hamb-line::after{transform:rotate(45deg);top:0}@media screen and (max-width:768px){.headerLinks{width:100%;height:100%;position:fixed;top:60px;left:0;z-index:10;background-color:#121110;overflow:hidden;max-height:0;transition:max-height .5s ease-out;display:flex;align-items:center;justify-content:center}.headerLinks ul{display:flex;flex-direction:column;align-items:center;justify-content:center}.hamb{display:block}}.postDate{float:right;color:#8a8272}.postTitle{color:#e8a33d;text-decoration:none;text-transform:capitalize;font-family:fira mono,monospace;font-size:1.2em;float:left}.postHeader{overflow:hidden}.postsList{margin-top:20px}.postListItem{padding:20px;background-color:#1a1815;border:1px solid #2a261f;margin-bottom:20px}.postExcerpt{text-align:initial;text-decoration:none;color:#e9e3d6}.headerContainer{display:flex;justify-content:space-between}.noDecoration{text-decoration:none}a,a:link,a:visited,a:hover,a:active{text-decoration:none}.socialNavbar ul{list-style:none;padding:0;margin:0}.socialNavbar ul li{display:inline}.socialNavbar a{font-family:fira mono,monospace;font-size:.9em;color:#8a8272;border-bottom:1px solid #2a261f;padding-bottom:2px;text-decoration:none;-webkit-font-smoothing:antialiased;display:inline-block;margin:0 28px 0 0}.socialNavbar a:hover{color:#f5c065;border-bottom-color:#f5c065}.postWrapper{text-align:left;color:#cfc9bc}.postWrapper h1{color:#f7f3e8}.postWrapper h2{color:#f7f3e8;border-bottom:2px solid #e8a33d;padding-bottom:8px;margin-top:2.4em}.postMetadata{font-family:fira mono,monospace;display:block;background:#1a1815;padding:10px}dt,dd{line-height:1.5}dl{display:grid;grid-template-columns:max-content auto}dt{grid-column-start:1}dd{grid-column-start:2}dt::after{content:":"}.listHeader,.listContent{text-align:left}.indexWrapper{display:flex;flex-direction:column;justify-content:center;text-align:left;padding:40px 0}.indexColumns{display:flex;gap:40px;align-items:flex-start;justify-content:space-between}.indexMain{flex:auto;min-width:0}.indexPhoto{margin:6px 0 0;flex-shrink:0;width:230px;box-sizing:border-box;background:#1a1815;border:1px solid #2a261f;padding:12px 12px 10px}.indexPhoto img{display:block;width:100%;height:auto;filter:saturate(.9)}.indexPhoto figcaption{font-family:fira mono,monospace;font-size:.8em;color:#8a8272;margin-top:10px}@media screen and (max-width:991px){.indexColumns{flex-direction:column;gap:36px}.indexPhoto{width:240px;max-width:100%}}.promptLine{font-family:fira mono,monospace;font-size:.95em;color:#8a8272;margin:0 0 16px}.indexHeader{font-size:3.4em;margin:0 0 10px;letter-spacing:-2px}.indexRole{font-family:fira mono,monospace;font-size:1.35em;font-weight:500;color:#e8a33d;margin:0 0 6px}.indexTagline{color:#8a8272;margin:0 0 42px}.cursor{display:none;width:8px;height:1.1em;background:#e8a33d;margin-left:6px;vertical-align:text-bottom;animation:blink 1.1s step-end infinite}.promptLine.active .cursor{display:inline-block}@keyframes blink{0%,49%{opacity:1}50%,100%{opacity:0}}@media(prefers-reduced-motion:reduce){.cursor{animation:none}}.lsList{list-style:none;padding:0;margin:0 0 42px;font-family:fira mono,monospace;font-size:.95em}.lsList li{display:flex;gap:20px;align-items:baseline;margin-bottom:12px}.lsMode{color:#565043;flex-shrink:0}.lsName{min-width:110px;font-weight:500;text-decoration:none}.lsDesc{font-family:open sans,sans-serif;font-size:.92em;color:#b8b0a0}.workSection{margin-top:48px;border-top:1px solid #2a261f}.workSection .promptLine{margin:36px 0 22px}.workList{list-style:none;padding:0;margin:0}.workItem{display:flex;gap:24px;align-items:baseline;background:#1a1815;border:1px solid #2a261f;padding:15px 20px;margin-bottom:14px}.workName{font-family:fira mono,monospace;font-weight:500;min-width:160px;flex-shrink:0;text-decoration:none}.workDesc{font-size:.9em;line-height:1.55;color:#b8b0a0}@media screen and (max-width:768px){.lsList li,.workItem{flex-direction:column;gap:4px}.lsMode{display:none}}.content{text-align:center;margin:0 auto;flex:1 auto;padding:20px}@media only screen and (min-width:992px){.content{display:flex;width:760px}}.vertical{display:flex;flex-direction:column;justify-content:center}.flexWrapper{display:flex;flex-direction:column;justify-content:center;min-height:100vh}.main{width:100%;height:100%}